# Локальные секреты стенда. Скопируй в atlas.env и заполни.
# Файл в .gitignore (каталог .secrets/), в git не попадает.

# Токен воркера (Настройки → «Создать токен воркера» в Atlas; старый заменяется)
ATLAS_WORKER_TOKEN=

# OAuth Яндекс.Диска для кнопки «Подключить Яндекс.Диск».
# Redirect URI должен совпадать с приложением на oauth.yandex.ru.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/settings/yadisk/callback
