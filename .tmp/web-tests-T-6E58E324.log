    </div>\n    </section>\n  );\n}\n\nfunction RhythmStep({\n  onDone,\n  onSkip,\n}: {\n  onDone: () => void;\n  onSkip: () => void;\n}) {\n  const action = useAction(onDone);\n  const [time, setTime] = useState(\'08:00\');\n\n  async function approve(): Promise<void> {\n    await action.run(\n      () =>\n        putGrowthSettings({\n          daily_enabled: true,\n          daily_at: time,\n          weekly_enabled: true,\n          weekly_at: \'19:00\',\n          weekly_day: 6,\n          triage_enabled: true,\n          audit_enabled: true,\n          nudge_enabled: true,\n        }).then(() => undefined),\n      \'Ритм сохранён\',\n    );\n  }\n\n  return (\n    <section className="panel">\n      <h2>Ритм и обзоры</h2>\n      <ErrorNote error={action.error} />\n      <Preview\n        items={[`Напоминания в ${time}`, \'Недельный обзор в воскресенье\']}\n      />\n      <TextField\n        label="Утреннее напоминание"\n        type="time"\n        value={time}\n        onChange={(event) => setTime(event.target.value)}\n      />\n      <div className="row">\n        <Button\n          variant="primary"\n          onClick={() => void approve()}\n          loading={action.busy}\n        >\n          Утвердить\n        </Button>\n        <Button variant="ghost" onClick={onSkip}>\n          Пропустить\n        </Button>\n      </div>\n    </section>\n  );\n}\n\nfunction AgentToneStep({\n  onDone,\n  onSkip,\n}: {\n  onDone: () => void;\n  onSkip: () => void;\n}) {\n  const action = useAction(onDone);\n  const [tone, setTone] = useState(\'кратко\');\n  const [depth, setDepth] = useState(\'обычная\');\n  const profile = useResource<Profile>(() => api(\'/api/profile\'), []);\n\n  async function approve(): Promise<void> {\n    await action.run(\n      () =>\n        api(\'/api/profile\', {\n          method: \'PUT\',\n          body: JSON.stringify({\n            data: {\n              ...(profile.data?.data ?? {}),\n              agent: { tone, depth },\n            